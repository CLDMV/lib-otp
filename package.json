{
	"name": "@cldmv/lib-otp",
	"version": "0.0.1",
	"description": "Configurable TOTP codes, otpauth/QR enrolment and a pure lockout state machine",
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/src/index.d.mts",
	"bin": {
		"otp": "./bin/otp.mjs"
	},
	"exports": {
		".": {
			"lib-otp-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/",
		"bin/",
		"!bin/**/*.map"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "tsup",
		"build:ci": "npm run lint && npm run format:check && npm run types:build && npm run build",
		"prepack": "npm run build",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\"",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"types:build": "tsc -p .configs/tsconfig.json",
		"types:check": "tsc -p .configs/tsconfig.json --noEmit",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/lib-otp.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/lib-otp/issues"
	},
	"homepage": "https://github.com/CLDMV/lib-otp#readme",
	"devDependencies": {
		"@cldmv/configs": "^1.4.0",
		"@cldmv/eslint-plugin-jsonv": "^1.1.2",
		"@cldmv/fix-headers": "^2.2.6",
		"@cldmv/jsonv": "^1.2.2",
		"@cldmv/prettier-plugin-jsonv": "^1.2.2",
		"@cldmv/vitest-runner": "^1.6.1",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^8.0.3",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	}
}
